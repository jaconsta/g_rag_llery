{
  "image": "mcr.microsoft.com/devcontainers/rust:1-trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/nix:1": {}
  },
  "forwardPorts": [4200, 4201, 65434],
  "portsAttributes": {
    "4200": {
      "label": "Server App",
      "onAutoForward": "notify"
    },
    "4201": {
      "label": "Web App",
      "onAutoForward": "notify"
    },
    "65434": {
      "label": "PostgreSQL",
      "onAutoForward": "ignore"
    }
  }
}
